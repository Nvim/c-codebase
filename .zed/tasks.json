[
	{
		"label": "Build vk",
		"command": "cmake",
		"args": ["--build", "build", "--target", "vk"],
		"env": {},
		"use_new_terminal": false,
		"allow_concurrent_runs": false,
		"reveal": "always",
		"reveal_target": "dock",
