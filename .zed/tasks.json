		"show_command": true,
		"save": "none",
	},
	{
		"label": "Run vk",
		"command": "build/runtime/vk",
		"env": {},
		"use_new_terminal": false,
		"allow_concurrent_runs": false,
		"reveal": "always",
		"reveal_target": "dock",
		"hide": "never",
		"shell": "system",
		"show_summary": true,
		"show_command": true,
		"save": "none",
	},
]
